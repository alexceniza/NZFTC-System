@{
    ViewData["Title"] = "Leave Management";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";

    // Loads all leave requests for the admin review table.
    var adminLeaveRequests = ViewData["AdminLeaveRequests"] as string[][] ?? Array.Empty<string[]>();

    // Loads simple leave reporting counts.
    var totalLeaveRequests = ViewData["TotalLeaveRequests"]?.ToString() ?? "0";
    var approvedLeaveRequests = ViewData["ApprovedLeaveRequests"]?.ToString() ?? "0";
    var pendingLeaveRequests = ViewData["PendingLeaveRequests"]?.ToString() ?? "0";
    var rejectedLeaveRequests = ViewData["RejectedLeaveRequests"]?.ToString() ?? "0";
}

@section Styles {
    <!-- Admin leave CSS -->
    <link rel="stylesheet" href="~/css/admin-leave.css" asp-append-version="true" />
}

<!-- Admin leave page -->
<section class="admin-leave-page">
    <!-- Page heading -->
    <div class="admin-leave-heading">
        <h1>Leave Management</h1>
        <p>Approve requests and view leave reporting</p>
    </div>

    <!-- Leave history card -->
    <section class="admin-leave-card">
        <!-- Card heading -->
        <div class="admin-leave-card-heading">
            <h2>Leave History</h2>
            <p>Review leave requests and their status</p>
        </div>

        <!-- Leave table -->
        <div class="admin-leave-table-wrapper">
            <table class="admin-leave-table">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Employee</th>
                        <th>Type</th>
                        <th>Dates</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (adminLeaveRequests.Length == 0)
                    {
                        <!-- Empty state row -->
                        <tr>
                            <td colspan="8">No leave requests found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var leaveRequest in adminLeaveRequests)
                        {
                            var requestId = leaveRequest[0];
                            var employeeName = leaveRequest[1];
                            var employeeCode = leaveRequest[2];
                            var leaveType = leaveRequest[3];
                            var leaveDates = leaveRequest[4];
                            var leaveDays = leaveRequest[5];
                            var leaveReason = leaveRequest[6];
                            var leaveStatus = leaveRequest[7];
                            var leaveRequestId = leaveRequest[8];

                            var statusClass = leaveStatus == "Approved"
                            ? "approved-status"
                            : leaveStatus == "Rejected" || leaveStatus == "Declined"
                            ? "rejected-status"
                            : "pending-status";

                            <tr>
                                <td>@requestId</td>
                                <td>@employeeName<br />@employeeCode</td>
                                <td>@leaveType</td>
                                <td>@leaveDates</td>
                                <td>@leaveDays</td>
                                <td>@leaveReason</td>
                                <td>
                                    <span class="leave-status-badge @statusClass">@leaveStatus</span>
                                </td>
                                <td>
                                    @if (leaveStatus == "Pending")
                                    {
                                        <div class="leave-action-group">
                                            <form method="post" asp-controller="AdminLeave" asp-action="ApproveLeave">
                                                <input type="hidden" name="leaveRequestId" value="@leaveRequestId" />
                                                <button type="submit" class="leave-action-button approve-button">Approve</button>
                                            </form>

                                            <form method="post" asp-controller="AdminLeave" asp-action="RejectLeave">
                                                <input type="hidden" name="leaveRequestId" value="@leaveRequestId" />
                                                <button type="submit" class="leave-action-button reject-button">Reject</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Reporting snapshot -->
    <section class="admin-reporting-card">
        <!-- Card heading -->
        <div class="admin-reporting-heading">
            <h2>Leave Reporting Snapshot</h2>
            <p>Overview of all leave requests</p>
        </div>

        <!-- Reporting grid -->
        <div class="admin-reporting-grid">
            <!-- Snapshot card -->
            <article class="report-stat-card">
                <h3>Total Requests</h3>
                <div class="report-stat-value">@totalLeaveRequests</div>
            </article>

            <!-- Snapshot card -->
            <article class="report-stat-card">
                <h3>Approved</h3>
                <div class="report-stat-value approved-value">@approvedLeaveRequests</div>
            </article>

            <!-- Snapshot card -->
            <article class="report-stat-card">
                <h3>Pending</h3>
                <div class="report-stat-value pending-value">@pendingLeaveRequests</div>
            </article>

            <!-- Snapshot card -->
            <article class="report-stat-card">
                <h3>Rejected</h3>
                <div class="report-stat-value rejected-value">@rejectedLeaveRequests</div>
            </article>
        </div>
    </section>
</section>