@model List<NZFTC_Portal.ViewModels.AdminEmployeeViewModel>

@{
    ViewData["Title"] = "Employee Management";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";

    // Tracks whether the add employee modal should reopen after a form result.
    var hasAddEmployeeFeedback =
        TempData["Error"] != null ||
        TempData["Success"] != null ||
        TempData["ErrorMessage"] != null ||
        TempData["SuccessMessage"] != null;
}

@section Styles {
    <!-- Admin employees CSS -->
    <link rel="stylesheet" href="~/css/admin-employees.css" asp-append-version="true" />

    <style>
        /* Add employee form feedback */
        .employee-form-feedback {
            margin: 0 0 16px 0;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 14px;
        }

        .employee-form-error {
            background: #fff1f1;
            border: 1px solid #f1b7b7;
            color: #9f2f2f;
        }

        .employee-form-success {
            background: #f2fff4;
            border: 1px solid #b8e0bf;
            color: #23663a;
        }
    </style>
}

<!-- Admin employees page -->
<section class="admin-employees-page">
    <!-- Page heading -->
    <div class="admin-employees-heading">
        <h1>Employee Management</h1>
        <p>View and manage employee records</p>
    </div>

    <!-- Employee directory card -->
    <section class="employee-directory-card">
        <!-- Card top row -->
        <div class="employee-directory-top">
            <div class="employee-directory-heading">
                <h2>Employee Directory</h2>
                <p>All employees in the organization</p>
            </div>

            <div class="employee-directory-action">
                <button type="button" class="add-employee-button" id="openAddEmployeeModal">+ Add Employee</button>
            </div>
        </div>

        <!-- Employee table -->
        <div class="employee-table-wrapper">
            <table class="employee-table">
                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Join Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <!-- Empty state row -->
                        <tr>
                            <td colspan="8">No employee records found.</td>
                        </tr>
                    }
                    else
                    {
                        <!-- Employee directory rows -->
                        @foreach (var employee in Model)
                        {
                            var employeeId = employee.EmployeeCode;
                            var employeeName = employee.FullName;
                            var employeeEmail = employee.Email;
                            var employeeDepartment = employee.Department;
                            var employeePosition = employee.Position;
                            var employeeJoinDate = employee.JoinDate.ToString("dd/MM/yyyy");
                            var employeeStatus = employee.EmploymentStatus;
                            var statusClass = employeeStatus == "Active" ? "active-status" : "leave-status";

                            <tr>
                                <td>@employeeId</td>
                                <td>@employeeName</td>
                                <td>@employeeEmail</td>
                                <td>@employeeDepartment</td>
                                <td>@employeePosition</td>
                                <td>@employeeJoinDate</td>
                                <td>
                                    <span class="employee-status-badge @statusClass">@employeeStatus</span>
                                </td>
                                <td>
                                    <button type="button"
                                            class="view-button open-view-employee-modal"
                                            data-employee-id="@employeeId"
                                            data-employee-name="@employeeName"
                                            data-employee-email="@employeeEmail"
                                            data-employee-department="@employeeDepartment"
                                            data-employee-position="@employeePosition"
                                            data-employee-join-date="@employeeJoinDate"
                                            data-employee-status="@employeeStatus">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

<!-- Add employee modal -->
<div class="employee-modal-overlay" id="addEmployeeModal">
    <div class="employee-modal" role="dialog" aria-modal="true" aria-labelledby="addEmployeeModalTitle">
        <!-- Modal close -->
        <button type="button" class="employee-modal-close" id="closeAddEmployeeModal" aria-label="Close add employee modal">
            x
        </button>

        <!-- Modal heading -->
        <div class="employee-modal-header">
            <h2 id="addEmployeeModalTitle">Add Employee</h2>
            <p>Create a new employee profile</p>
        </div>

        @if (TempData["Error"] != null || TempData["ErrorMessage"] != null)
        {
            <!-- Add employee form error -->
            <div class="employee-form-feedback employee-form-error">
                @(TempData["Error"] ?? TempData["ErrorMessage"])
            </div>
        }

        @if (TempData["Success"] != null || TempData["SuccessMessage"] != null)
        {
            <!-- Add employee form success -->
            <div class="employee-form-feedback employee-form-success">
                @(TempData["Success"] ?? TempData["SuccessMessage"])
            </div>
        }

        <!-- Modal form -->
        <form class="employee-modal-form" id="addEmployeeForm" method="post" asp-controller="AdminEmployee" asp-action="Create">
            @Html.AntiForgeryToken()

            <div class="employee-form-group">
                <label for="employeeFullName">Full Name</label>
                <input type="text" id="employeeFullName" name="FullName" placeholder="Enter full name" />
            </div>

            <div class="employee-form-row">
                <div class="employee-form-group">
                    <label for="employeeContact">Contact</label>
                    <input type="text" id="employeeContact" name="ContactNumber" placeholder="Enter contact number" />
                </div>

                <div class="employee-form-group">
                    <label for="employeeEmergencyContact">Emergency Contact</label>
                    <input type="text" id="employeeEmergencyContact" name="EmergencyContact" placeholder="Enter emergency contact" />
                </div>
            </div>

            <div class="employee-form-group">
                <label for="employeeEmail">Email</label>
                <input type="text" id="employeeEmail" name="Email" placeholder="Enter email address" />
            </div>

            <div class="employee-form-row">
                <div class="employee-form-group">
                    <label for="employeeRole">Role</label>
                    <select id="employeeRole" name="Role">
                        <option value="">Select role</option>
                        <option value="Employee">Employee</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <div class="employee-form-group">
                    <label for="employeeRoleId">Role ID</label>
                    <input type="text" id="employeeRoleId" name="EmployeeCode" placeholder="EMP001 / ADM001" />
                </div>
            </div>

            <div class="employee-form-group hidden-role-field" id="confirmationCodeGroup">
                <label for="employeeConfirmationCode">Confirmation Code</label>
                <input type="text" id="employeeConfirmationCode" name="ConfirmationCode" placeholder="12 digit confirmation code" maxlength="12" />
            </div>

            <div class="employee-form-group">
                <label for="employeeTraining">Prior Training</label>
                <textarea id="employeeTraining" name="TrainingRecord" rows="3" placeholder="Enter prior training if any"></textarea>
            </div>

            <div class="employee-form-group">
                <label for="employeeHistory">Employment History</label>
                <textarea id="employeeHistory" name="EmploymentHistory" rows="3" placeholder="Enter employment history if any"></textarea>
            </div>

            <div class="employee-form-row">
                <div class="employee-form-group">
                    <label for="employeeDepartment">Department</label>
                    <input type="text" id="employeeDepartment" name="Department" placeholder="Enter department" />
                </div>

                <div class="employee-form-group">
                    <label for="employeePosition">Position</label>
                    <input type="text" id="employeePosition" name="Position" placeholder="Enter position" />
                </div>
            </div>

            <div class="employee-modal-actions">
                <button type="button" class="employee-cancel-button" id="cancelAddEmployeeModal">Cancel</button>
                <button type="submit" class="employee-submit-button">Add Employee</button>
            </div>
        </form>
    </div>
</div>

<!-- Confirm create account modal -->
<div class="employee-modal-overlay" id="confirmCreateAccountModal">
    <div class="employee-modal" role="dialog" aria-modal="true" aria-labelledby="confirmCreateAccountModalTitle">
        <!-- Modal close -->
        <button type="button" class="employee-modal-close" id="closeConfirmCreateAccountModal" aria-label="Close create account confirmation modal">
            x
        </button>

        <!-- Modal heading -->
        <div class="employee-modal-header">
            <h2 id="confirmCreateAccountModalTitle">Confirm Account Creation</h2>
            <p>Are you sure you want to create this account?</p>
        </div>

        <div class="employee-modal-actions">
            <button type="button" class="employee-cancel-button" id="cancelConfirmCreateAccountModal">Cancel</button>
            <button type="button" class="employee-submit-button" id="confirmCreateAccountButton">Confirm</button>
        </div>
    </div>
</div>

<!-- View employee modal -->
<div class="employee-modal-overlay" id="viewEmployeeModal">
    <div class="employee-modal" role="dialog" aria-modal="true" aria-labelledby="viewEmployeeModalTitle">
        <!-- Modal close -->
        <button type="button" class="employee-modal-close" id="closeViewEmployeeModal" aria-label="Close employee details modal">
            x
        </button>

        <!-- Modal heading -->
        <div class="employee-modal-header">
            <h2 id="viewEmployeeModalTitle">Employee Details</h2>
            <p>View selected employee information</p>
        </div>

        <!-- Read-only employee information -->
        <div class="employee-modal-form">
            <div class="employee-form-row">
                <div class="employee-form-group">
                    <label for="viewEmployeeId">Employee ID</label>
                    <input type="text" id="viewEmployeeId" readonly />
                </div>

                <div class="employee-form-group">
                    <label for="viewEmployeeStatus">Status</label>
                    <input type="text" id="viewEmployeeStatus" readonly />
                </div>
            </div>

            <div class="employee-form-group">
                <label for="viewEmployeeName">Full Name</label>
                <input type="text" id="viewEmployeeName" readonly />
            </div>

            <div class="employee-form-group">
                <label for="viewEmployeeEmail">Email</label>
                <input type="text" id="viewEmployeeEmail" readonly />
            </div>

            <div class="employee-form-row">
                <div class="employee-form-group">
                    <label for="viewEmployeeDepartment">Department</label>
                    <input type="text" id="viewEmployeeDepartment" readonly />
                </div>

                <div class="employee-form-group">
                    <label for="viewEmployeePosition">Position</label>
                    <input type="text" id="viewEmployeePosition" readonly />
                </div>
            </div>

            <div class="employee-form-group">
                <label for="viewEmployeeJoinDate">Join Date</label>
                <input type="text" id="viewEmployeeJoinDate" readonly />
            </div>

            <div class="employee-modal-actions">
                <button type="button" class="employee-cancel-button" id="cancelViewEmployeeModal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const addEmployeeModal = document.getElementById("addEmployeeModal");
        const openAddEmployeeModal = document.getElementById("openAddEmployeeModal");
        const closeAddEmployeeModal = document.getElementById("closeAddEmployeeModal");
        const cancelAddEmployeeModal = document.getElementById("cancelAddEmployeeModal");
        const addEmployeeForm = document.getElementById("addEmployeeForm");
        const employeeRole = document.getElementById("employeeRole");
        const confirmationCodeGroup = document.getElementById("confirmationCodeGroup");

        const confirmCreateAccountModal = document.getElementById("confirmCreateAccountModal");
        const closeConfirmCreateAccountModal = document.getElementById("closeConfirmCreateAccountModal");
        const cancelConfirmCreateAccountModal = document.getElementById("cancelConfirmCreateAccountModal");
        const confirmCreateAccountButton = document.getElementById("confirmCreateAccountButton");

        let allowCreateAccountSubmit = false;

        // Opens the add employee modal.
        function showAddEmployeeModal() {
            addEmployeeModal.classList.add("show");
            document.body.classList.add("employee-modal-open");
        }

        // Clears add employee feedback messages after the modal is manually closed.
        function clearAddEmployeeFeedback() {
            const feedbackMessages = addEmployeeModal.querySelectorAll(".employee-form-feedback");
            feedbackMessages.forEach(function (message) {
                message.remove();
            });
        }

        // Closes the add employee modal.
        function hideAddEmployeeModal() {
            addEmployeeModal.classList.remove("show");
            document.body.classList.remove("employee-modal-open");
            clearAddEmployeeFeedback();
        }

        // Opens the create account confirmation modal.
        function showConfirmCreateAccountModal() {
            confirmCreateAccountModal.classList.add("show");
            document.body.classList.add("employee-modal-open");
        }

        // Closes the create account confirmation modal.
        function hideConfirmCreateAccountModal() {
            confirmCreateAccountModal.classList.remove("show");
            document.body.classList.remove("employee-modal-open");
        }

        // Shows the confirmation code field only for admin role selection.
        function toggleConfirmationCodeField() {
            if (employeeRole.value === "Admin") {
                confirmationCodeGroup.classList.remove("hidden-role-field");
            } else {
                confirmationCodeGroup.classList.add("hidden-role-field");
            }
        }

        openAddEmployeeModal.addEventListener("click", showAddEmployeeModal);
        closeAddEmployeeModal.addEventListener("click", hideAddEmployeeModal);
        cancelAddEmployeeModal.addEventListener("click", hideAddEmployeeModal);

        // Closes the add employee modal when the overlay is clicked.
        addEmployeeModal.addEventListener("click", function (event) {
            if (event.target === addEmployeeModal) {
                hideAddEmployeeModal();
            }
        });

        // Stops immediate submit and opens the confirmation modal first.
        addEmployeeForm.addEventListener("submit", function (event) {
            if (!allowCreateAccountSubmit) {
                event.preventDefault();
                showConfirmCreateAccountModal();
            }
        });

        // Allows the real submit after confirmation.
        confirmCreateAccountButton.addEventListener("click", function () {
            allowCreateAccountSubmit = true;
            hideConfirmCreateAccountModal();
            addEmployeeForm.submit();
        });

        closeConfirmCreateAccountModal.addEventListener("click", hideConfirmCreateAccountModal);
        cancelConfirmCreateAccountModal.addEventListener("click", hideConfirmCreateAccountModal);

        // Closes the confirmation modal when the overlay is clicked.
        confirmCreateAccountModal.addEventListener("click", function (event) {
            if (event.target === confirmCreateAccountModal) {
                hideConfirmCreateAccountModal();
            }
        });

        employeeRole.addEventListener("change", toggleConfirmationCodeField);
        toggleConfirmationCodeField();

        // Reopens the add employee modal when the form returns an error or success message.
        const hasAddEmployeeFeedback = @hasAddEmployeeFeedback.ToString().ToLower();

        if (hasAddEmployeeFeedback) {
            showAddEmployeeModal();
        }

        const viewEmployeeModal = document.getElementById("viewEmployeeModal");
        const closeViewEmployeeModal = document.getElementById("closeViewEmployeeModal");
        const cancelViewEmployeeModal = document.getElementById("cancelViewEmployeeModal");
        const viewEmployeeButtons = document.querySelectorAll(".open-view-employee-modal");

        // Opens the employee details modal.
        function showViewEmployeeModal() {
            viewEmployeeModal.classList.add("show");
            document.body.classList.add("employee-modal-open");
        }

        // Closes the employee details modal.
        function hideViewEmployeeModal() {
            viewEmployeeModal.classList.remove("show");
            document.body.classList.remove("employee-modal-open");
        }

        // Loads the selected employee details into the read-only modal fields.
        function populateViewEmployeeModal(button) {
            document.getElementById("viewEmployeeId").value = button.getAttribute("data-employee-id") || "";
            document.getElementById("viewEmployeeName").value = button.getAttribute("data-employee-name") || "";
            document.getElementById("viewEmployeeEmail").value = button.getAttribute("data-employee-email") || "";
            document.getElementById("viewEmployeeDepartment").value = button.getAttribute("data-employee-department") || "";
            document.getElementById("viewEmployeePosition").value = button.getAttribute("data-employee-position") || "";
            document.getElementById("viewEmployeeJoinDate").value = button.getAttribute("data-employee-join-date") || "";
            document.getElementById("viewEmployeeStatus").value = button.getAttribute("data-employee-status") || "";
        }

        // Opens the employee details modal for the selected row.
        viewEmployeeButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                populateViewEmployeeModal(button);
                showViewEmployeeModal();
            });
        });

        closeViewEmployeeModal.addEventListener("click", hideViewEmployeeModal);
        cancelViewEmployeeModal.addEventListener("click", hideViewEmployeeModal);

        // Closes the view employee modal when the overlay is clicked.
        viewEmployeeModal.addEventListener("click", function (event) {
            if (event.target === viewEmployeeModal) {
                hideViewEmployeeModal();
            }
        });

        // Closes whichever employee modal is currently open when Escape is pressed.
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                if (addEmployeeModal.classList.contains("show")) {
                    hideAddEmployeeModal();
                }

                if (confirmCreateAccountModal.classList.contains("show")) {
                    hideConfirmCreateAccountModal();
                }

                if (viewEmployeeModal.classList.contains("show")) {
                    hideViewEmployeeModal();
                }
            }
        });
    </script>
}