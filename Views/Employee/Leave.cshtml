@{
    ViewData["Title"] = "Employee Leave";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";

    // Loads the logged-in employee leave history rows.
    var employeeLeaveRequests = ViewData["EmployeeLeaveRequests"] as string[][] ?? Array.Empty<string[]>();

    // Tracks whether the leave request modal should reopen after a form result.
    var hasLeaveFeedback = TempData["LeaveError"] != null || TempData["LeaveSuccess"] != null;
}

@section Styles {
    <!-- Employee leave CSS -->
    <link rel="stylesheet" href="~/css/employee-leave.css" asp-append-version="true" />

    <style>
        /* Leave form feedback */
        .leave-form-feedback {
            margin: 0 0 16px 0;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 14px;
        }

        .leave-form-error {
            background: #fff1f1;
            border: 1px solid #f1b7b7;
            color: #9f2f2f;
        }

        .leave-form-success {
            background: #f2fff4;
            border: 1px solid #b8e0bf;
            color: #23663a;
        }
    </style>
}

<!-- Leave page -->
<section class="leave-page">
    <!-- Page heading row -->
    <div class="leave-page-top">
        <!-- Page heading -->
        <div class="leave-heading">
            <h1>My Leave</h1>
            <p>Request leave and view your history</p>
        </div>

        <!-- Request leave button -->
        <div class="leave-top-action">
            <button type="button" class="request-leave-button" id="openLeaveModal">+ Request Leave</button>
        </div>
    </div>

    <!-- Leave history card -->
    <section class="leave-card">
        <!-- Section heading -->
        <div class="leave-card-heading">
            <h2>Leave History</h2>
            <p>Your leave requests and their status</p>
        </div>

        <!-- Leave table -->
        <div class="leave-table-wrapper">
            <table class="leave-table">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (employeeLeaveRequests.Length == 0)
                    {
                        <!-- Empty state row -->
                        <tr>
                            <td colspan="7">No leave requests found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var leaveRequest in employeeLeaveRequests)
                        {
                            var requestId = leaveRequest[0];
                            var leaveType = leaveRequest[1];
                            var startDate = leaveRequest[2];
                            var endDate = leaveRequest[3];
                            var leaveDays = leaveRequest[4];
                            var leaveStatus = leaveRequest[5];
                            var leaveReason = leaveRequest[6];

                            var statusClass = leaveStatus == "Approved"
                            ? "approved-status"
                            : leaveStatus == "Rejected"
                            ? "rejected-status"
                            : "pending-status";

                            <tr>
                                <td>@requestId</td>
                                <td>@leaveType</td>
                                <td>@startDate</td>
                                <td>@endDate</td>
                                <td>@leaveDays</td>
                                <td>
                                    <span class="status-badge @statusClass">@leaveStatus</span>
                                </td>
                                <td>@leaveReason</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

<!-- Leave request modal -->
<div class="leave-modal-overlay" id="leaveModal">
    <div class="leave-modal" role="dialog" aria-modal="true" aria-labelledby="leaveModalTitle">
        <!-- Modal close -->
        <button type="button" class="leave-modal-close" id="closeLeaveModal" aria-label="Close leave request modal">
            x
        </button>

        <!-- Modal heading -->
        <div class="leave-modal-header">
            <h2 id="leaveModalTitle">Request Leave</h2>
            <p>Submit a new leave request for approval</p>
        </div>

        @if (TempData["LeaveError"] != null)
        {
            <!-- Leave form error -->
            <div class="leave-form-feedback leave-form-error">
                @TempData["LeaveError"]
            </div>
        }

        @if (TempData["LeaveSuccess"] != null)
        {
            <!-- Leave form success -->
            <div class="leave-form-feedback leave-form-success">
                @TempData["LeaveSuccess"]
            </div>
        }

        <!-- Modal form -->
        <form class="leave-modal-form" id="leaveRequestForm" method="post" asp-controller="EmployeeLeave" asp-action="SubmitLeave">
            <!-- Leave type -->
            <div class="leave-form-group">
                <label for="leaveType">Leave Type</label>
                <select id="leaveType" name="leaveType" required>
                    <option value="">Select leave type</option>
                    <option value="Annual Leave">Annual Leave</option>
                    <option value="Sick Leave">Sick Leave</option>
                    <option value="Bereavement Leave">Bereavement Leave</option>
                    <option value="Unpaid Leave">Unpaid Leave</option>
                </select>
            </div>

            <!-- Date row -->
            <div class="leave-form-row">
                <div class="leave-form-group">
                    <label for="startDate">Start Date</label>
                    <input type="date" id="startDate" name="startDate" required />
                </div>

                <div class="leave-form-group">
                    <label for="endDate">End Date</label>
                    <input type="date" id="endDate" name="endDate" required />
                </div>
            </div>

            <!-- Reason -->
            <div class="leave-form-group">
                <label for="leaveReason">Reason</label>
                <textarea id="leaveReason" name="leaveReason" rows="5" placeholder="Brief description of your leave request"></textarea>
            </div>

            <!-- Modal actions -->
            <div class="leave-modal-actions">
                <button type="button" class="leave-cancel-button" id="cancelLeaveModal">Cancel</button>
                <button type="submit" class="leave-submit-button">Submit Request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const leaveModal = document.getElementById("leaveModal");
        const openLeaveModal = document.getElementById("openLeaveModal");
        const closeLeaveModal = document.getElementById("closeLeaveModal");
        const cancelLeaveModal = document.getElementById("cancelLeaveModal");
        const leaveFeedbackMessages = document.querySelectorAll(".leave-form-feedback");

        // Hides any leave feedback messages after the initial postback display.
        function hideLeaveFeedbackMessages() {
            leaveFeedbackMessages.forEach(function (message) {
                message.style.display = "none";
            });
        }

        // Opens the leave request modal.
        function showLeaveModal() {
            hideLeaveFeedbackMessages();
            leaveModal.classList.add("show");
            document.body.classList.add("leave-modal-open");
        }

        // Opens the leave request modal with feedback still visible after submit.
        function showLeaveModalWithFeedback() {
            leaveModal.classList.add("show");
            document.body.classList.add("leave-modal-open");
        }

        // Closes the leave request modal.
        function hideLeaveModal() {
            hideLeaveFeedbackMessages();
            leaveModal.classList.remove("show");
            document.body.classList.remove("leave-modal-open");
        }

        openLeaveModal.addEventListener("click", showLeaveModal);
        closeLeaveModal.addEventListener("click", hideLeaveModal);
        cancelLeaveModal.addEventListener("click", hideLeaveModal);

        // Closes the leave request modal when the overlay is clicked.
        leaveModal.addEventListener("click", function (event) {
            if (event.target === leaveModal) {
                hideLeaveModal();
            }
        });

        // Reopens the leave request modal when the form returns an error or success message.
        const hasLeaveFeedback = @hasLeaveFeedback.ToString().ToLower();

        if (hasLeaveFeedback) {
            showLeaveModalWithFeedback();
        }

        // Closes the leave request modal when Escape is pressed.
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && leaveModal.classList.contains("show")) {
                hideLeaveModal();
            }
        });
    </script>
}