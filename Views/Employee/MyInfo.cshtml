@model NZFTC_Portal.ViewModels.EmployeeMyInfoViewModel

@{
    ViewData["Title"] = "Employee My Info";
    Layout = "~/Views/Shared/_PortalLayout.cshtml";

    var hasCaseFeedback =
        TempData["ErrorMessage"] != null ||
        TempData["SuccessMessage"] != null;
}

@section Styles {
    <!-- Employee my info CSS -->
    <link rel="stylesheet" href="~/css/employee-myinfo.css" asp-append-version="true" />

    <style>
        .case-form-feedback {
            margin: 0 0 16px 0;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 14px;
        }

        .case-form-error {
            background: #fff1f1;
            border: 1px solid #f1b7b7;
            color: #9f2f2f;
        }

        .case-form-success {
            background: #f2fff4;
            border: 1px solid #b8e0bf;
            color: #23663a;
        }

        .resolved-status,
        .closed-status {
            background-color: #c8efd2;
            border: 1px solid #64b977;
            color: #2f9a47;
        }

        .rejected-status {
            background-color: #f2cccc;
            border: 1px solid #d86b6b;
            color: #c43f3f;
        }
    </style>
}

<!-- My information page -->
<section class="myinfo-page">
    <!-- Page heading -->
    <div class="myinfo-heading">
        <h1>My Information</h1>
        <p>View and manage your personal information and cases</p>
    </div>

    <!-- Personal information card -->
    <section class="myinfo-card personal-info-card">
        <!-- Card heading -->
        <div class="card-heading">
            <h2>Personal Information</h2>
            <p>Your employee details and contact information</p>
        </div>

        <!-- Profile update form -->
        <form method="post" asp-controller="Employee" asp-action="UpdateProfile" id="profileUpdateForm">
            @Html.AntiForgeryToken()

            <!-- Tracks which editable field is being saved. -->
            <input type="hidden" name="updateField" id="updateField" />

            <!-- Personal information grid -->
            <div class="personal-info-grid">
                <div class="info-group">
                    <label for="employeeId">Employee ID</label>
                    <input type="text" id="employeeId" class="info-input" value="@Model.EmployeeId" readonly />
                </div>

                <div class="info-group">
                    <label>Status</label>
                    <div class="status-box active-status">@Model.Status</div>
                </div>

                <div class="info-group">
                    <label for="fullName">Full Name</label>
                    <input type="text" id="fullName" class="info-input" value="@Model.FullName" readonly />
                </div>

                <div class="info-group info-group-empty"></div>

                <div class="info-group">
                    <label for="contactNumber">Contact Number</label>
                    <div class="editable-row">
                        <input type="text"
                               id="contactNumber"
                               name="contactNumber"
                               class="info-input editable-input"
                               value="@Model.ContactNumber"
                               readonly />
                        <button type="button" class="edit-button" data-target="contactNumber">Edit</button>
                    </div>
                </div>

                <div class="info-group">
                    <label for="emergencyContact">Emergency Contact</label>
                    <div class="editable-row">
                        <input type="text"
                               id="emergencyContact"
                               name="emergencyContact"
                               class="info-input editable-input"
                               value="@Model.EmergencyContact"
                               readonly />
                        <button type="button" class="edit-button" data-target="emergencyContact">Edit</button>
                    </div>
                </div>

                <div class="info-group">
                    <label>Email Address</label>
                    <input type="text" class="info-input" value="@Model.EmailAddress" readonly />
                </div>

                <div class="info-group info-group-empty"></div>

                <div class="info-group">
                    <label>Department</label>
                    <input type="text" class="info-input" value="@Model.Department" readonly />
                </div>

                <div class="info-group">
                    <label>Position</label>
                    <input type="text" class="info-input" value="@Model.Position" readonly />
                </div>

                <div class="info-group">
                    <label>Join Date</label>
                    <input type="text" class="info-input" value="@Model.JoinDate" readonly />
                </div>

                <div class="info-group info-group-empty"></div>
            </div>
        </form>
    </section>

    <!-- Cases card -->
    <section class="myinfo-card cases-card">
        <!-- Cases heading row -->
        <div class="cases-top">
            <div class="card-heading">
                <h2>My Cases</h2>
                <p>Submit and track your grievances and resignation</p>
            </div>

            <div class="cases-action">
                <button type="button" class="submit-case-button" id="openCaseModal">+ Submit Case</button>
            </div>
        </div>

        <!-- Cases table -->
        <div class="cases-table-wrapper">
            <table class="cases-table">
                <thead>
                    <tr>
                        <th>Case ID</th>
                        <th>Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cases == null || !Model.Cases.Any())
                    {
                        <tr>
                            <td colspan="3">No cases submitted yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var caseItem in Model.Cases)
                        {
                            var statusClass =
                            caseItem.Status == "Closed" ? "closed-status"
                            : caseItem.Status == "Resolved" ? "resolved-status"
                            : caseItem.Status == "Rejected" ? "rejected-status"
                            : "pending-status";

                            <tr>
                                <td>CS-@caseItem.CaseId.ToString("D3")</td>
                                <td>@caseItem.CaseType</td>
                                <td>
                                    <span class="case-status @statusClass">@caseItem.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

<!-- Submit case modal -->
<div class="case-modal-overlay" id="caseModal">
    <div class="case-modal" role="dialog" aria-modal="true" aria-labelledby="caseModalTitle">
        <!-- Modal close -->
        <button type="button" class="case-modal-close" id="closeCaseModal" aria-label="Close submit case modal">
            x
        </button>

        <!-- Modal heading -->
        <div class="case-modal-header">
            <h2 id="caseModalTitle">Submit a Case</h2>
            <p>Submit a new grievance, complaint, or resignation</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="case-form-feedback case-form-error">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="case-form-feedback case-form-success">
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Modal form -->
        <form class="case-modal-form" id="caseRequestForm" method="post" asp-controller="EmployeeCase" asp-action="Create">
            @Html.AntiForgeryToken()

            <div class="case-form-group">
                <label for="caseType">Case Type</label>
                <select id="caseType" name="CaseType">
                    <option value="Grievance">Grievance</option>
                    <option value="Resignation">Resignation</option>
                    <option value="Complaint">Complaint</option>
                </select>
            </div>

            <div class="case-form-group">
                <label for="caseSubject">Subject</label>
                <input type="text" id="caseSubject" name="Subject" placeholder="Brief summary of the issue" />
            </div>

            <div class="case-form-group">
                <label for="caseDescription">Description</label>
                <textarea id="caseDescription" name="Description" rows="5" placeholder="Detailed description of your grievance or resignation reason"></textarea>
            </div>

            <div class="case-modal-actions">
                <button type="button" class="case-cancel-button" id="cancelCaseModal">Cancel</button>
                <button type="submit" class="case-submit-button">Submit Case</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const profileUpdateForm = document.getElementById("profileUpdateForm");
        const updateField = document.getElementById("updateField");
        const editButtons = document.querySelectorAll(".edit-button");

        // Resets all editable fields back to readonly mode.
        function resetEditableFields() {
            editButtons.forEach(function (button) {
                const targetId = button.getAttribute("data-target");
                const targetInput = document.getElementById(targetId);

                targetInput.setAttribute("readonly", "readonly");
                targetInput.classList.remove("editing");
                button.textContent = "Edit";
            });
        }

        // Enables editing for one profile field at a time.
        editButtons.forEach(function (button) {
            button.addEventListener("click", function () {
                const targetId = button.getAttribute("data-target");
                const targetInput = document.getElementById(targetId);

                if (targetInput.hasAttribute("readonly")) {
                    resetEditableFields();
                    targetInput.removeAttribute("readonly");
                    targetInput.classList.add("editing");
                    button.textContent = "Save";
                    targetInput.focus();
                    targetInput.select();
                    return;
                }

                if (!confirm("Save this change?")) {
                    return;
                }

                updateField.value = targetId;
                profileUpdateForm.submit();
            });
        });

        const caseModal = document.getElementById("caseModal");
        const openCaseModal = document.getElementById("openCaseModal");
        const closeCaseModal = document.getElementById("closeCaseModal");
        const cancelCaseModal = document.getElementById("cancelCaseModal");

        // Opens the submit case modal.
        function showCaseModal() {
            caseModal.classList.add("show");
            document.body.classList.add("case-modal-open");
        }

        // Clears case feedback after the modal is manually closed.
        function clearCaseFeedback() {
            const feedbackMessages = caseModal.querySelectorAll(".case-form-feedback");
            feedbackMessages.forEach(function (message) {
                message.remove();
            });
        }

        // Closes the submit case modal.
        function hideCaseModal() {
            caseModal.classList.remove("show");
            document.body.classList.remove("case-modal-open");
            clearCaseFeedback();
        }

        openCaseModal.addEventListener("click", showCaseModal);
        closeCaseModal.addEventListener("click", hideCaseModal);
        cancelCaseModal.addEventListener("click", hideCaseModal);

        // Closes the modal when the overlay is clicked.
        caseModal.addEventListener("click", function (event) {
            if (event.target === caseModal) {
                hideCaseModal();
            }
        });

        // Closes the modal when Escape is pressed.
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && caseModal.classList.contains("show")) {
                hideCaseModal();
            }
        });

        const hasCaseFeedback = @hasCaseFeedback.ToString().ToLower();

        if (hasCaseFeedback) {
            showCaseModal();
        }
    </script>
}